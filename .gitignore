# Build output (make); everything under build/ is generated
/build/

# Third-party tools installed locally for building and testing (AgDev, the
# emulator, MOS firmware, a host build of ez80asm); see BUILDING.md. The one
# exception is ez80asm's Agon binary, which is redistributed with its licence.
/third_party/*
!/third_party/ez80asm/

# This machine's tool locations (see config.mk)
/config.local.mk

# Generated by tests/tools/run_emulator.py on every run; never a source of truth
/emulator_sdcard/

# The known-good snapshot: a git worktree at the `tested` tag
/tested/

# Assembler and linker output anywhere else (test programs build beside their sources)
*.bin
*.lst
*.map
*.o
*.obj
obj/
!/third_party/ez80asm/ez80asm.bin

# The tested compiler, ready to copy to an SD card
!/install/**/*.bin

# Binary test fixtures are real source, not build output
!tests/libc_c/fixtures/*.bin

# Editor, OS and Python noise
*.swp
*~
.DS_Store
Thumbs.db
__pycache__/
